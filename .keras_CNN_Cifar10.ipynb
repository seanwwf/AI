from tensorflow import keras
from keras.models import Sequential
from keras.layers import Dense, Conv2D, MaxPooling2D, Flatten

# 建立一個序列模型
model = Sequential()

# 第一層卷積層：64個filter，5x5卷積核，輸入形狀為32x32彩色圖(3通道)，ReLU激活
model.add(Conv2D(filters=64, kernel_size=(5, 5), input_shape=(32, 32, 3), activation='relu'))

# 第二層卷積層：64個filter，5x5卷積核，ReLU激活
model.add(Conv2D(filters=64, kernel_size=(5, 5), activation='relu'))

# 最大池化層，池化大小2x2，將特徵圖尺寸縮小為原來的一半
model.add(MaxPooling2D(pool_size=2))

# 第三層卷積層：128個filter，5x5卷積核，ReLU激活
model.add(Conv2D(filters=128, kernel_size=(5, 5), activation='relu'))

# 第四層卷積層：128個filter，5x5卷積核，ReLU激活
model.add(Conv2D(filters=128, kernel_size=(5, 5), activation='relu'))

# 第二個最大池化層，池化大小2x2，尺寸再次縮小一半
model.add(MaxPooling2D(pool_size=2))

# 攤平成1維向量，方便輸入全連接層
model.add(Flatten())

# 全連接層，輸出10類別（CIFAR-10的10個分類），使用softmax激活函數
model.add(Dense(10, activation='softmax'))

# 印出模型摘要，顯示每層輸出尺寸和參數量
model.summary()

# 編譯模型，使用RMSprop優化器，損失函數為多類別交叉熵，並監控準確率
model.compile(optimizer='rmsprop', loss='categorical_crossentropy', metrics=['accuracy'])


# 載入CIFAR-10資料集
cifar10 = keras.datasets.cifar10
(train_data, train_label), (test_data, test_label) = cifar10.load_data()

# 保存原始的train_label（shape為(50000,1)），方便後續查看標籤
train_label_original = train_label

# 將標籤轉成one-hot編碼，方便多類別分類訓練
train_label = keras.utils.to_categorical(train_label)
test_label = keras.utils.to_categorical(test_label)


# 載入matplotlib繪圖模組，定義類別名稱
import matplotlib.pyplot as plt
category = ['airplane', 'automobile', 'bird', 'cat', 'deer', 'dog', 'frog', 'horse', 'ship', 'truck']

# 顯示訓練資料第一張圖片和對應的標籤文字
plt.imshow(train_data[0])
plt.title(category[int(train_label_original[0])])  # 將原始標籤轉成類別名稱
plt.show()

# 印出第一筆資料的原始標籤數字
print(train_label_original[0])  # [6]


# 訓練模型，設定30個epoch，batch_size為512
train_history = model.fit(train_data, train_label, epochs=30, batch_size=512)


# 範例訓練結果，準確率由0.17提升到約0.93，但測試集準確率較低（約0.59）


# 在測試資料上評估模型，並輸出準確率
score = model.evaluate(test_data, test_label)
print(score[1])  # 約0.5923（59.23%）


# 繪製訓練過程中的準確率與損失曲線
import matplotlib.pyplot as plt
import numpy as np

def show_train_history(train_history, train):
    plt.plot(train_history.history[train])
    plt.title('Train History')
    plt.ylabel(train)
    plt.xlabel('Epoch')
    plt.legend(['train'], loc='center right')
    plt.show()

# 繪製訓練準確率曲線
show_train_history(train_history, 'accuracy')

# 繪製訓練損失曲線
show_train_history(train_history, 'loss')
