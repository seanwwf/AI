from tensorflow import keras
from keras.models import Sequential
from keras.layers import Dense, Flatten

# 建立序列模型 (Sequential)
model = Sequential()

# 將輸入的28x28像素的圖像攤平成一維向量 (28*28=784)
model.add(Flatten())

# 新增全連接層 (Dense layer)，32個神經元，啟用函數使用ReLU
# input_dim=784是輸入資料的維度(攤平成一維後)
model.add(Dense(32, activation='relu', input_dim=784))

# 新增輸出層，10個神經元（對應0~9共10個類別），啟用函數使用sigmoid
model.add(Dense(10, activation='sigmoid'))

# 編譯模型
# optimizer選用'rmsprop'（優化器）
# loss用'sparse_categorical_crossentropy'（適合多類別分類，且標籤為整數形式）
# metrics中加入'accuracy'，在訓練時會同時輸出準確率
model.compile(optimizer='rmsprop', loss='sparse_categorical_crossentropy', metrics=['accuracy'])

# 載入MNIST手寫數字資料集
mnist = keras.datasets.mnist
(train_data, train_label), (test_data, test_label) = mnist.load_data()

# 輸出訓練資料型態與維度
print(type(train_data))       # <class 'numpy.ndarray'>
print(train_data.shape)       # (60000, 28, 28)，60000張28x28像素圖片
print(type(train_label))      # <class 'numpy.ndarray'>
print(train_label.shape)      # (60000,)，60000張圖片對應的標籤
print(test_data.shape)        # (10000, 28, 28)，測試集圖片數量
print(test_label.shape)       # (10000,)，測試集標籤數量

# 印出第一筆訓練標籤（即該張圖片所代表的數字）
print(train_label[0])  # 5

# 印出第一張圖片的像素陣列（28x28的灰階值，0-255）
print(train_data[0])

# 使用 matplotlib 顯示第一張圖片
import matplotlib.pyplot as plt
plt.imshow(train_data[0], cmap='binary')  # 黑白顯示
plt.show()

# 開始訓練模型
# epochs=20：訓練20個完整週期
# batch_size=512：每次梯度更新使用512筆資料
model.fit(train_data, train_label, epochs=20, batch_size=512)

# 訓練過程中會印出每個epoch的loss(損失值)與accuracy(準確率)
# 隨著訓練進行，loss會下降，accuracy會提高

# 使用測試集評估模型效能
score = model.evaluate(test_data, test_label)
print(score[1])  # 印出測試集準確率（accuracy），約為0.9305
